            "name": "aggregate-low-high-picks-high"
        },
        {
            "args": [["LOW", "MED"]],
            "expect": {
                "rendered": "MED"
            },
            "fixture": "ref-scheme-1",
            "method": "aggregate",
            "name": "aggregate-low-med-picks-med"
        },
        {
