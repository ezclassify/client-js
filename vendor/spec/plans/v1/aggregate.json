            },
            "fixture": "ref-scheme-1",
            "method": "aggregate",
            "name": "aggregate-duplicate-concepts-dedup"
        },
        {
            "args": [["MED", "HIGH", "CTRL-A"]],
            "expect": {
                "rendered": "HIGH/CTRL-A"
            },
            "fixture": "ref-scheme-1",
            "method": "aggregate",
            "name": "aggregate-three-markings-with-controls"
