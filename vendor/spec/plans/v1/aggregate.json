            "expect": {
                "rendered": "HIGH/CTRL-A"
            },
            "fixture": "ref-scheme-1",
            "method": "aggregate",
            "name": "aggregate-high-ctrl-a-includes-controls"
        },
        {
            "args": [["LOW"]],
            "expect": {
                "rendered": "LOW"
            },
            "fixture": "ref-scheme-1",
            "method": "aggregate",
            "name": "aggregate-single-low"
        },
        {
            "args": [[]],
            "expect": {
                "rendered": ""
            },
            "fixture": "ref-scheme-1",
            "method": "aggregate",
            "name": "aggregate-empty-array"
        },
        {
            "args": [["HIGH", "LOW", "MED"]],
