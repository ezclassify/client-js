{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "minProperties": 34, "maxProperties": 34,
  "patternProperties": {
    "^case-(?!(?:23|26)$)[0-9]{2}$": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "text": { "type": "string" }, "marking": { "type": "string" },
        "responseProfile": { "enum": ["summary", "standard", "full"] },
        "responseProfiles": { "type": "array", "items": { "enum": ["summary", "standard", "full"] }, "uniqueItems": true },
        "userAttributes": { "type": "object" }, "context": { "type": "object" },
        "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } }, "fixtureVariant": { "enum": ["no-guide", "no-access", "share-list"] },
        "contextVersion": { "type": "string" }, "contextVariants": { "type": "array", "items": { "enum": ["inline", "source-backed"] }, "minItems": 2, "maxItems": 2, "uniqueItems": true },
        "guideDeterminations": { "$ref": "#/$defs/determinations" },
        "projectedFindingIds": { "type": "array", "items": { "$ref": "#/$defs/sha" } },
        "computedOverrideFixture": { "type": "object", "required": ["computedRuleId", "overridesRuleId"], "additionalProperties": false, "properties": { "computedRuleId": { "type": "string" }, "overridesRuleId": { "type": "string" } } },
        "sourceRecipe": { "$ref": "#/$defs/sourceRecipe" }, "profileContract": { "$ref": "#/$defs/profileContract" },
        "genericSchemeScenarios": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/genericScenario" } }, "forbidDomainBranches": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "determinationPermutations": { "$ref": "#/$defs/determinationPermutations" }, "conflictingDuplicate": { "$ref": "#/$defs/conflictingDuplicate" },
        "textRecipes": { "type": "array", "items": { "$ref": "#/$defs/textRecipe" } },
        "invalidInputRecipes": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/invalidRecipe" } },
        "manualSelectionCollision": { "$ref": "#/$defs/manualCollision" },
        "orderingRecipe": { "$ref": "#/$defs/orderingRecipe" }, "redactionContract": { "$ref": "#/$defs/redactionContract" },
        "cliContract": { "$ref": "#/$defs/cliContract" }, "reachabilityContract": { "$ref": "#/$defs/reachabilityContract" }
      },
      "anyOf": [{ "required": ["text"] }, { "required": ["marking"] }, { "required": ["textRecipes"] }, { "required": ["invalidInputRecipes"] }]
    }
  },
  "properties": {
    "case-23": { "$ref": "#/$defs/case23" },
    "case-26": { "$ref": "#/$defs/case26" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "assertion": { "type": "object", "additionalProperties": false, "required": ["categoryId", "conceptId"], "properties": { "categoryId": { "type": "string", "minLength": 1 }, "conceptId": { "type": "string", "minLength": 1 }, "value": { "type": "string" } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "version"], "properties": { "kind": { "enum": ["scheme", "guide", "access", "context"] }, "id": { "type": "string" }, "version": { "type": "string" } } },
    "rule": { "type": "object", "additionalProperties": false, "required": ["artifact", "ruleId", "ruleDigest"], "properties": { "artifact": { "$ref": "#/$defs/artifact" }, "ruleId": { "type": "string" }, "ruleDigest": { "$ref": "#/$defs/sha" } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["start", "end", "offsetEncoding", "rule"], "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 }, "offsetEncoding": { "const": "utf-8-bytes" }, "rule": { "$ref": "#/$defs/rule" } } },
    "determinations": {
      "type": "object", "additionalProperties": false, "required": ["findings", "manualSelections"],
      "properties": {
        "findings": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["findingId", "documentDigest", "decision", "reason"], "properties": { "findingId": { "$ref": "#/$defs/sha" }, "documentDigest": { "$ref": "#/$defs/sha" }, "decision": { "enum": ["accepted", "rejected"] }, "reason": { "type": "string", "minLength": 1 } } } },
        "manualSelections": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["documentDigest", "rule", "evidence", "reason"], "properties": { "documentDigest": { "$ref": "#/$defs/sha" }, "rule": { "$ref": "#/$defs/rule" }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }, "reason": { "type": "string", "minLength": 1 } } } }
      }
    },
    "textRecipe": { "type": "object", "additionalProperties": false, "required": ["encoding", "codePoints"], "properties": { "encoding": { "const": "unicode-code-points" }, "codePoints": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 1114111 } } } },
    "invalidRecipe": { "type": "object", "additionalProperties": false, "required": ["surface", "encoding"], "properties": { "surface": { "enum": ["javascript-host-string", "utf8-host", "json-host"] }, "encoding": { "enum": ["utf-16-code-units-hex", "bytes-hex", "escaped-code-unit"] }, "hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})+$" }, "escaped": { "type": "string" } }, "oneOf": [{ "required": ["hex"] }, { "required": ["escaped"] }] },
    "manualCollision": { "type": "object", "additionalProperties": false, "required": ["rule", "evidence"], "properties": { "rule": { "$ref": "#/$defs/rule" }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } } } }
    ,"sourceRecipe": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["reproducibility", "snapshotId"], "properties": { "reproducibility": { "const": "reproducible" }, "snapshotId": { "$ref": "#/$defs/sha" } } },
        { "type": "object", "additionalProperties": false, "required": ["reproducibility", "locator"], "properties": { "reproducibility": { "const": "best-effort" }, "locator": { "type": "string", "pattern": "^https?://" } } },
        {
          "type": "object", "additionalProperties": false,
          "required": ["mutation", "sourceReadCounters", "duplicateCanonicalQueries", "sharedLimitationCode"],
          "properties": {
            "mutation": { "const": "change-on-every-read" },
            "sourceReadCounters": { "type": "object", "additionalProperties": false, "required": ["artifactResolve", "sourceIdentity", "canonicalQuery"], "properties": { "artifactResolve": { "const": 1 }, "sourceIdentity": { "const": 1 }, "canonicalQuery": { "const": 1 } } },
            "duplicateCanonicalQueries": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["id", "fields"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 } } } },
            "sharedLimitationCode": { "const": "best-effort-source" }
          }
        }
      ]
    },
    "profileContract": { "type": "object", "additionalProperties": false, "required": ["equalPaths", "summaryOmissions", "standardOmissions", "fullDetailsComplete", "supportCatalogDeduplicated", "omittedArraysAbsentNotEmpty"], "properties": { "equalPaths": { "type": "array", "minItems": 4, "items": { "type": "string" } }, "summaryOmissions": { "type": "array", "minItems": 2, "items": { "type": "string" } }, "standardOmissions": { "type": "array", "minItems": 3, "items": { "type": "string" } }, "fullDetailsComplete": { "const": true }, "supportCatalogDeduplicated": { "const": true }, "omittedArraysAbsentNotEmpty": { "const": true } } },
    "genericScenario": { "type": "object", "additionalProperties": false, "required": ["scheme", "inputs", "expectedOperator"], "properties": { "scheme": { "enum": ["cvss", "tlp", "geography"] }, "inputs": { "type": "array", "minItems": 2, "items": { "type": "string" } }, "expectedOperator": { "enum": ["composition", "taxonomy", "union-first"] } } },
    "orderingRecipe": { "type": "object", "additionalProperties": false, "required": ["shuffleDeterminations", "shuffleManualSelections", "randomizeSourceCompletion", "reverseMapInsertion", "expectedEqualSemanticJson", "expectedEqualIds"], "properties": { "shuffleDeterminations": { "const": true }, "shuffleManualSelections": { "const": true }, "randomizeSourceCompletion": { "const": true }, "reverseMapInsertion": { "const": true }, "expectedEqualSemanticJson": { "const": true }, "expectedEqualIds": { "const": true } } },
    "redactionContract": { "type": "object", "additionalProperties": false, "required": ["forbiddenByDefault", "surfaces", "fullExplicitlyReturns", "fullDoesNotChangeLogging"], "properties": { "forbiddenByDefault": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } }, "surfaces": { "type": "array", "minItems": 5, "items": { "enum": ["logs", "telemetry", "errors", "cli-process-arguments", "standard-response"] }, "uniqueItems": true }, "fullExplicitlyReturns": { "type": "array", "items": { "enum": ["matched-text", "authored-part-text"] }, "minItems": 2, "maxItems": 2, "uniqueItems": true }, "fullDoesNotChangeLogging": { "const": true } } },
    "cliContract": { "type": "object", "additionalProperties": false, "required": ["commands", "modes", "fixtures", "exitCodes", "requireJsonParity", "sensitiveInputs"], "properties": { "commands": { "type": "array", "items": { "enum": ["document-audit", "document-assess-access"] }, "minItems": 2, "maxItems": 2, "uniqueItems": true }, "modes": { "type": "array", "items": { "enum": ["local", "remote"] }, "minItems": 2, "maxItems": 2, "uniqueItems": true }, "fixtures": { "type": "array", "minItems": 6, "items": { "type": "string" } }, "exitCodes": { "type": "object", "additionalProperties": false, "required": ["sufficient-or-granted", "authoritative-failure", "operational-or-stale", "indeterminate-or-projected-only"], "properties": { "sufficient-or-granted": { "const": 0 }, "authoritative-failure": { "const": 1 }, "operational-or-stale": { "const": 2 }, "indeterminate-or-projected-only": { "const": 3 } } }, "requireJsonParity": { "const": true }, "sensitiveInputs": { "type": "array", "items": { "enum": ["stdin", "file"] }, "minItems": 2, "maxItems": 2, "uniqueItems": true } } },
    "reachabilityContract": { "type": "object", "additionalProperties": false, "required": ["determinedFactKinds", "projectedFactKind", "rejectedFindingReachable", "joins", "requiredDecisionFields"], "properties": { "determinedFactKinds": { "type": "array", "items": { "enum": ["accepted-finding", "manual-selection"] }, "minItems": 2, "maxItems": 2, "uniqueItems": true }, "projectedFactKind": { "const": "projected-finding" }, "rejectedFindingReachable": { "const": false }, "joins": { "type": "array", "minItems": 3, "items": { "type": "string" } }, "requiredDecisionFields": { "type": "array", "items": { "enum": ["decision", "reason"] }, "minItems": 2, "maxItems": 2, "uniqueItems": true } } },
    "determinationPermutations": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha" } } },
    "conflictingDuplicate": { "type": "object", "additionalProperties": false, "required": ["findingId", "decision", "reason"], "properties": { "findingId": { "$ref": "#/$defs/sha" }, "decision": { "const": "rejected" }, "reason": { "type": "string", "minLength": 1 } } },
    "case23": { "type": "object", "additionalProperties": false, "required": ["marking", "assertions"], "properties": { "marking": { "type": "string", "minLength": 1 }, "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } } } },
    "case26": { "type": "object", "additionalProperties": false, "required": ["text", "responseProfile", "guideDeterminations", "determinationPermutations", "conflictingDuplicate"], "properties": { "text": { "type": "string", "minLength": 1 }, "responseProfile": { "const": "full" }, "guideDeterminations": { "$ref": "#/$defs/determinations" }, "determinationPermutations": { "$ref": "#/$defs/determinationPermutations" }, "conflictingDuplicate": { "$ref": "#/$defs/conflictingDuplicate" } } }
  }
}
