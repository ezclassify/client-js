# npm supply-chain hardening: never run dependency install/lifecycle scripts.
ignore-scripts=true

# The publish-date quarantine for third-party packages is deliberately NOT set
# here. npm's `min-release-age` is tree-wide with no supported way to exempt a
# scope, so a window in this file would quarantine our own freshly published
# @ezclassify packages too and `npm ci` would fail with ETARGET. The window
# belongs in a CI step that can tell first-party from third-party.
